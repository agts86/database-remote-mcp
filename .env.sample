# Application Configuration
APP_PORT=お好みのポート番号を指定してください 例：3000

# MCP Tools Configuration
# 有効化するMCPツールをカンマ区切りで指定（未設定時は全ツール有効化）
# 利用可能なツール: read_query, write_query, export_query, list_tables, describe_table, get_schema, create_table, alter_table, drop_table, append_insight, list_insights
# 例: ENABLED_TOOLS=read_query,list_tables,describe_table
ENABLED_TOOLS=

# NoSQL MCP Tools Configuration
# 有効化するNoSQL MCPツールをカンマ区切りで指定（未設定時は全NoSQLツール有効化）
# 利用可能なツール: list_collections
# 例: ENABLED_NOSQL_TOOLS=list_collections
ENABLED_NOSQL_TOOLS=

# Database Configuration
# DB_TYPE: sqlserver, postgres, mysql, または mongodb（デフォルト: postgres）
DB_TYPE=postgres

# SQL Server の場合
SERVER=データベースサーバー 例：localhost
PORT=データベースポート 例：1433
DATABASE=データベース名 例：master
USER=データベースログインユーザー 例：sa
PASSWORD=データベースログインユーザーパスワード 例：test1234

# PostgreSQL の場合（DB_TYPE=postgres に変更して使用）
# SERVER=localhost
# PORT=5432
# DATABASE=mydb
# USER=postgres
# PASSWORD=postgres
# DB_SSL=true

# MySQL の場合（DB_TYPE=mysql に変更して使用）
# SERVER=localhost
# PORT=3306
# DATABASE=mydb
# USER=root
# PASSWORD=mysql
# DB_SSL=true

# MongoDB の場合（DB_TYPE=mongodb に変更して使用）
# MONGO_URI=mongodb://localhost:27017
# MONGO_DATABASE=admin
